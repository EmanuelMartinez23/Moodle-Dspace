{{!
    Encabezado de página para el tema hijo UAM Lerma.
    Basado en theme_boost/templates/head.mustache, pero forzando favicon/logo UAM.
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    {{{ output.standard_head_html }}}
    {{! Forzar favicon/logotipo UAM en las pestañas del navegador }}
    <link rel="icon" type="image/svg+xml" href="[[pix:theme|uam-logo]]">
    <link rel="shortcut icon" href="[[pix:theme|uam-logo]]">
    {{! Opcional: icono para Apple }}
    <link rel="apple-touch-icon" href="[[pix:theme|uam-logo]]">
    {{! Fallbacks de tamaños comunes (si existe PNG/JPG con el mismo nombre, Moodle lo servirá) }}
    <link rel="icon" sizes="32x32" href="[[pix:theme|uam-logo]]">
    <link rel="icon" sizes="192x192" href="[[pix:theme|uam-logo]]">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{! Nota: mantenemos el resto del head estándar vía output.standard_head_html }}
</head>
